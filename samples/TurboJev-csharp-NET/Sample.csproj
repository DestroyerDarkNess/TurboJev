<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TurboJevRid Condition="'$(TurboJevRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</TurboJevRid>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="TurboJev"><HintPath>../.artifacts/$(TurboJevRid)/dotnet/TurboJev.dll</HintPath></Reference>
  </ItemGroup>
</Project>
