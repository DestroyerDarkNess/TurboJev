{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbojev.dev/schemas/turbojev.specialization-run.schema.json",
  "title": "TurboJev specialization external evaluation run v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "id",
    "plan_id",
    "benchmark_suite",
    "model",
    "environment",
    "observations"
  ],
  "properties": {
    "contract": {
      "const": "turbojev.specialization-run.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_suite": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt_ir",
        "renderer_profile",
        "calibration"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "tokenizer_revision": {
          "type": "string",
          "minLength": 1
        },
        "prompt_ir": {
          "type": "string",
          "minLength": 1
        },
        "renderer_profile": {
          "type": "string",
          "minLength": 1
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "temperature",
            "fitted",
            "ece_bins"
          ],
          "properties": {
            "method": {
              "const": "temperature-softmax"
            },
            "temperature": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "fitted": {
              "type": "boolean"
            },
            "profile_id": {
              "type": "string",
              "minLength": 1
            },
            "ece_bins": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "host"
      ],
      "properties": {
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "execution_path": {
          "type": "string",
          "minLength": 1
        },
        "runner_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family_id",
          "case_id",
          "question_id",
          "variant",
          "candidate_keys",
          "logits",
          "target_key",
          "latency_seconds",
          "peak_memory_bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "variant": {
            "enum": [
              "baseline",
              "candidate-order",
              "paraphrase"
            ]
          },
          "candidate_keys": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "logits": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "number"
            }
          },
          "target_key": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "latency_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "peak_memory_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
