{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbojev.dev/schemas/turbojev.specialization-evaluation.schema.json",
  "title": "TurboJev generic-vs-specialized evaluation plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "benchmark_suite", "pairs", "metrics"],
  "properties": {
    "contract": { "const": "turbojev.specialization-evaluation.v1" },
    "id": { "type": "string", "minLength": 1 },
    "benchmark_suite": { "type": "string", "minLength": 1 },
    "pairs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["generic_model", "specialized_model"],
        "properties": {
          "generic_model": { "type": "string", "minLength": 1 },
          "specialized_model": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metrics": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
