        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "continue_from": {
          "type": "array"
        },
        "instructions": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "when": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": [
