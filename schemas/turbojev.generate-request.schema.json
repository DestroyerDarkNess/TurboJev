{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbojev.dev/schemas/generate-request.json",
  "title": "TurboJev GenerateRequest",
  "type": "object",
  "additionalProperties": false,
  "description": "Structural schema. Rust also checks types, scopes, dependency cycles, confidence gates, container restrictions, array prefixes and execution budgets before inference. Arrays are top-level; nested arrays and arrays in objects are rejected.",
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "questions"
          ],
          "not": {
            "required": [
              "schema"
            ]
          }
        },
        {
          "required": [
            "schema"
          ],
          "not": {
            "required": [
              "questions"
            ]
          }
        }
      ]
    },
    {
      "not": {
        "required": [
          "context",
          "state"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "sample"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "temperature": {
            "exclusiveMinimum": 0
          }
        }
      }
    }
  ],
  "properties": {
    "context": {},
    "state": {},
    "questions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "schema": {
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        },
        "description": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      }
    },
    "thinking": {
      "type": [
        "boolean",
        "string"
      ],
      "enum": [
        false,
        true,
        "auto"
      ]
    },
    "thinking_effort": {
      "enum": [
        "none",
        "low",
        "medium",
        "high"
      ]
    },
    "thinking_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "text_max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "numeric_max_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "images": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Base64 or image data URI strings. Hosts explicitly load paths/URLs."
    },
    "temperature": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Sample defaults to 1; otherwise defaults to 0. Explicit argmax never samples."
    },
    "mode": {
      "enum": [
        "argmax",
        "sample",
        null
      ],
      "description": "Explicit selection mode; positive temperature alone enables sampling."
    },
    "numeric_max_digits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096,
      "default": 32
    },
    "print_final_prompt": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "field": {
      "anyOf": [
        {
          "$ref": "#/$defs/scalar"
        },
        {
          "$ref": "#/$defs/object"
        },
        {
          "$ref": "#/$defs/array"
        }
      ]
    },
    "scalar": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "oneOf": [
            {
              "enum": [
                "string",
                "integer",
                "number",
                "boolean"
              ]
            },
            {
              "type": "array",
              "items": {
                "enum": [
                  "string",
                  "integer",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "contains": {
                "const": "null"
              }
            }
          ]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "instructions": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "when": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": false,
                "properties": {
                  "in": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "not_in": {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "ne": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "gt": {
                    "type": "number"
                  },
                  "gte": {
                    "type": "number"
                  },
                  "lt": {
                    "type": "number"
                  },
                  "lte": {
                    "type": "number"
                  },
                  "confidence": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "gt": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "gte": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "lt": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "lte": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "return_probabilities": {
          "type": "boolean"
        },
