{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbojev.dev/schemas/turbojev.runtime-qualification.schema.json",
  "title": "TurboJev Runtime Qualification Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract","id","fingerprint","harnessRevision","tolerance","summary","capabilities","evidenceSha256"],
  "properties": {
    "contract": {"const": "turbojev.runtime-qualification.v1"},
    "id": {"type":"string","minLength":1},
    "fingerprint": {
      "type":"object","additionalProperties":false,
      "required":["runtime","runtimeRevision","shimAbi","backend","hardware","model"],
      "properties": {
        "runtime":{"type":"string","minLength":1},
        "runtimeRevision":{"type":"string","minLength":1},
        "shimAbi":{"type":"integer","minimum":1},
        "backend":{"type":"string","minLength":1},
        "backendRevision":{"type":["string","null"]},
        "hardware":{"type":"object","additionalProperties":false,"required":["architecture","device"],"properties":{"architecture":{"type":"string","minLength":1},"device":{"type":"string","minLength":1},"driver":{"type":["string","null"]},"os":{"type":["string","null"]}}},
        "model":{"type":"object","additionalProperties":false,"required":["source","sha256"],"properties":{"source":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"revision":{"type":["string","null"]},"quantization":{"type":["string","null"]}}}
      }
    },
    "harnessRevision":{"type":"string","minLength":1},
    "tolerance":{"type":"object","additionalProperties":false,"required":["absolute","relative"],"properties":{"absolute":{"type":"number","minimum":0},"relative":{"type":"number","minimum":0}}},
    "summary":{"type":"object","additionalProperties":false,"required":["rounds","requests","maxAbsLogitDelta","maxRelativeLogitDelta","responseMismatches","isolationFailures","nonFiniteValues","passed"],"properties":{"rounds":{"type":"integer","minimum":1},"requests":{"type":"integer","minimum":1},"maxAbsLogitDelta":{"type":"number","minimum":0},"maxRelativeLogitDelta":{"type":"number","minimum":0},"responseMismatches":{"type":"integer","minimum":0},"isolationFailures":{"type":"integer","minimum":0},"nonFiniteValues":{"type":"integer","minimum":0},"passed":{"type":"boolean"}}},
    "capabilities":{"type":"object","additionalProperties":false,"required":["fusedBatch","cooperativeCancellation","hardDeadlines","maxFusedItems","estimatedFusedItemBytes"],"properties":{"fusedBatch":{"type":"boolean"},"cooperativeCancellation":{"type":"boolean"},"hardDeadlines":{"type":"boolean"},"maxFusedItems":{"type":["integer","null"],"minimum":2},"estimatedFusedItemBytes":{"type":["integer","null"],"minimum":1}}},
    "evidenceSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
