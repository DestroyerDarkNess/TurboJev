{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbojev.dev/schemas/turbojev.specialized-training-recipe.schema.json",
  "title": "TurboJev specialized training recipe v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "base_model", "method", "objective", "prompt_ir", "renderer_profile", "candidate_encoding", "max_context_tokens", "adapter", "optimization", "debiasing", "data", "splits"],
  "properties": {
    "contract": { "const": "turbojev.specialized-training-recipe.v1" },
    "id": { "type": "string", "minLength": 1 },
    "base_model": { "$ref": "#/$defs/base_model" },
    "method": { "enum": ["lora", "qlora"] },
    "objective": { "const": "candidate-logit-cross-entropy" },
    "prompt_ir": { "type": "string", "minLength": 1 },
    "renderer_profile": { "type": "string", "minLength": 1 },
    "candidate_encoding": { "$ref": "#/$defs/candidate_encoding" },
    "max_context_tokens": { "type": "integer", "minimum": 1 },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "alpha", "dropout", "target_modules"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "alpha": { "type": "number", "exclusiveMinimum": 0 },
        "dropout": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
        "target_modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learning_rate", "epochs", "micro_batch_size", "gradient_accumulation_steps", "warmup_ratio", "weight_decay", "seed"],
      "properties": {
        "learning_rate": { "type": "number", "exclusiveMinimum": 0 },
        "epochs": { "type": "integer", "minimum": 1 },
        "micro_batch_size": { "type": "integer", "minimum": 1 },
        "gradient_accumulation_steps": { "type": "integer", "minimum": 1 },
        "warmup_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "weight_decay": { "type": "number", "minimum": 0 },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "debiasing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_order_permutations", "candidate_code_permutations", "seed"],
      "properties": {
        "candidate_order_permutations": { "type": "integer", "minimum": 1 },
        "candidate_code_permutations": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages", "require_contrastive_pairs", "require_negative_no_match", "require_adversarial_criteria", "require_long_shared_state"],
      "properties": {
        "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "require_contrastive_pairs": { "type": "boolean" },
        "require_negative_no_match": { "type": "boolean" },
        "require_adversarial_criteria": { "type": "boolean" },
        "require_long_shared_state": { "type": "boolean" }
      }
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "calibration", "benchmark"],
      "properties": {
        "train": { "type": "string", "minLength": 1 },
        "validation": { "type": "string", "minLength": 1 },
        "calibration": { "type": "string", "minLength": 1 },
        "benchmark": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "base_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "tokenizer_revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "tokenizer_revision": { "type": "string", "minLength": 1 }
      }
    },
    "candidate_encoding": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "dynamic" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "profile"], "properties": { "kind": { "const": "profile" }, "profile": { "type": "string", "minLength": 1 } } }
      ]
    }
  }
}
