{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbojev.dev/schema/calibration-dataset-v1.json",
  "title": "TurboJev Calibration Dataset v1",
  "type": "object",
  "required": ["contract", "id", "examples"],
  "additionalProperties": false,
  "properties": {
    "contract": { "const": "turbojev.calibration-dataset.v1" },
    "id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "tokenizer_revision": { "type": "string", "minLength": 1 },
    "prompt_profile": { "type": "string", "minLength": 1 },
    "renderer_profile": { "type": "string", "minLength": 1 },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["logits", "target"],
        "additionalProperties": false,
        "properties": {
          "logits": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "number" }
          },
          "target": { "type": "integer", "minimum": 0 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 }
        }
      }
    }
  }
}
