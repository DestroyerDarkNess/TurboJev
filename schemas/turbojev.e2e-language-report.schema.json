{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbojev.dev/schemas/turbojev.e2e-language-report.schema.json",
  "title": "TurboJev Cross-Language E2E Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "modelSha256", "requestSha256", "referenceLanguage",
    "tolerance", "semanticParity", "parityMismatches", "results", "passed"
  ],
  "properties": {
    "contract": {"const": "turbojev.e2e-language-report.v2"},
    "modelSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "referenceLanguage": {"type": ["string", "null"]},
    "tolerance": {
      "type": "object", "additionalProperties": false,
      "required": ["absolute", "relative"],
      "properties": {
        "absolute": {"type": "number", "minimum": 0},
        "relative": {"type": "number", "minimum": 0}
      }
    },
    "semanticParity": {"type": "boolean"},
    "parityMismatches": {"type": "array", "items": {"type": "string"}},
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "durationMs", "exitCode", "stdoutSha256", "responseSha256", "message"],
        "properties": {
          "id": {"type": "string"},
          "status": {"enum": ["pass", "fail", "skip"]},
          "durationMs": {"type": "number", "minimum": 0},
          "exitCode": {"type": ["integer", "null"]},
          "stdoutSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "responseSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "message": {"type": ["string", "null"]}
        }
      }
    },
    "passed": {"type": "boolean"}
  }
}
