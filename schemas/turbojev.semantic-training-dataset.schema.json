{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbojev.dev/schemas/turbojev.semantic-training-dataset.schema.json",
  "title": "TurboJev semantic training dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "examples"],
  "properties": {
    "contract": { "const": "turbojev.semantic-training-dataset.v1" },
    "id": { "type": "string", "minLength": 1 },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/example" }
    }
  },
  "$defs": {
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "request", "targets"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "request": { "$ref": "#/$defs/request" },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/target" }
        },
        "weight": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "properties": { "$ref": "#/$defs/properties" }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contrastive_group": { "type": "string", "minLength": 1 },
        "negative_no_match": { "type": "boolean", "default": false },
        "adversarial_criteria": { "type": "boolean", "default": false },
        "long_shared_state": { "type": "boolean", "default": false }
      }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "choice" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "noul" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "score" },
            "value": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "questions"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "state": {},
        "questions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/question" }
        }
      }
    },
    "question": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions", "criteria"],
          "properties": {
            "type": { "const": "choice" },
            "instructions": { "type": "string", "minLength": 1 },
            "criteria": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions"],
          "properties": {
            "type": { "enum": ["noul", "boolean"] },
            "instructions": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "instructions", "criteria"],
          "properties": {
            "type": { "const": "score" },
            "instructions": { "type": "string", "minLength": 1 },
            "criteria": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    }
  }
}
