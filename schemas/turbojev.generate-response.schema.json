{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurboJev GenerateResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "thinking",
    "thinking_effort",
    "skipped",
    "usage"
  ],
  "properties": {
    "result": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "confidence",
              "probabilities",
              "distribution"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "probabilities": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "distribution": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "value",
                    "probability"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    },
                    "probability": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "thinking": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "thinking_effort": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "none",
          "low",
          "medium",
          "high"
        ]
      }
    },
    "skipped": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "usage": {
      "type": "object",
      "required": [
        "decisions"
      ],
      "properties": {
        "decisions": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "generated_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
