<Project>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' and '$(_TurboJevFrameworkNativeAssetsAdded)' != 'true'">
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\win-x86\native\*.dll">
      <Link>runtimes/win-x86/native/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\*.dll">
      <Link>runtimes/win-x64/native/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="$(MSBuildThisFileDirectory)..\runtimes\win-arm64\native\*.dll">
      <Link>runtimes/win-arm64/native/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <_TurboJevFrameworkNativeAssetsAdded>true</_TurboJevFrameworkNativeAssetsAdded>
  </PropertyGroup>
</Project>
