<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>TurboJev</PackageId>
    <Version>0.33.0</Version>
    <Authors>TurboJev contributors</Authors>
    <Description>Typed semantic decisions powered by TurboJev.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>semantic;classification;machine-learning;rust</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DestroyerDarkNess/TurboJev</RepositoryUrl>
    <PackageProjectUrl>https://github.com/DestroyerDarkNess/TurboJev</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <ItemGroup Condition="'$(TurboJevNativeRoot)' != ''">
    <None Include="$(TurboJevNativeRoot)\win-x86\*.dll" Pack="true" PackagePath="runtimes/win-x86/native/" />
    <None Include="$(TurboJevNativeRoot)\win-x64\*.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(TurboJevNativeRoot)\win-arm64\*.dll" Pack="true" PackagePath="runtimes/win-arm64/native/" />
  </ItemGroup>
</Project>
