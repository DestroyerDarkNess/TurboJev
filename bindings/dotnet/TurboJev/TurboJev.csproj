<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net48;net8.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>TurboJev</PackageId>
    <Version>0.34.0</Version>
    <Authors>TurboJev contributors</Authors>
    <Description>Typed semantic decisions powered by TurboJev.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>semantic;classification;machine-learning;rust</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/DestroyerDarkNess/TurboJev</RepositoryUrl>
    <PackageProjectUrl>https://github.com/DestroyerDarkNess/TurboJev</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64;linux-x86;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\..\LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="..\..\..\NOTICE" Pack="true" PackagePath="NOTICE" />
    <None Include="..\..\..\.cache\real-validation\llama.cpp\LICENSE" Pack="true" PackagePath="licenses/llama.cpp-LICENSE" />
    <None Include="..\..\..\.cache\real-validation\llama.cpp\vendor\**\LICENSE*" Pack="true" PackagePath="licenses/llama.cpp-vendor/%(RecursiveDir)" />
    <None Include="build\TurboJev.targets" Pack="true" PackagePath="build/;buildTransitive/" />
  </ItemGroup>
  <ItemGroup Condition="'$(TurboJevNativeRoot)' != ''">
    <None Include="$(TurboJevNativeRoot)\win-x86\*.dll" Pack="true" PackagePath="runtimes/win-x86/native/" />
    <None Include="$(TurboJevNativeRoot)\win-x64\*.dll" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="$(TurboJevNativeRoot)\win-arm64\*.dll" Pack="true" PackagePath="runtimes/win-arm64/native/" />
    <None Include="$(TurboJevNativeRoot)\linux-x86\*.so*" Pack="true" PackagePath="runtimes/linux-x86/native/" />
    <None Include="$(TurboJevNativeRoot)\linux-x64\*.so*" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="$(TurboJevNativeRoot)\linux-arm64\*.so*" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="$(TurboJevNativeRoot)\osx-x64\*.dylib" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="$(TurboJevNativeRoot)\osx-arm64\*.dylib" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
  </ItemGroup>
</Project>
